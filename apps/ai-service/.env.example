# 注意：所有变量带 AI_ 前缀（对应 Settings 的 env_prefix）

# 内网令牌，需与 nest-backend 的 AI_SERVICE_TOKEN 一致
AI_INTERNAL_TOKEN=dev-internal-token

# 服务
AI_HOST=0.0.0.0
AI_PORT=8000

# 向量库
AI_VECTOR_STORE=local
AI_VECTOR_STORE_URL=http://localhost:6333
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_API_KEY=

# LLM
AI_LLM_PROVIDER=openai
AI_LLM_API_KEY=
AI_LLM_MODEL=gpt-4o-mini

# RAG 切片
AI_CHUNK_SIZE=512
AI_CHUNK_OVERLAP=64
