# 服务端口
PORT=3000

# 内网 Python AI 服务
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=dev-internal-token
AI_SERVICE_TIMEOUT_MS=120000

# 会话/用户存储（本地默认 SQLite；生产换 MySQL/PG）
DATABASE_URL=./data/nest.db
DB_SYNCHRONIZE=true

# 鉴权
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=24h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 上传限制
MAX_FILE_SIZE_MB=50

# CORS
CORS_ORIGIN=http://localhost:5173
