# 构建阶段
FROM node:20-alpine AS build
WORKDIR /app

RUN corepack enable
COPY pnpm-workspace.yaml package.json ./
COPY apps/web-ui/package.json apps/web-ui/
RUN pnpm install --filter @ai-rag/web-ui --no-frozen-lockfile

COPY apps/web-ui apps/web-ui
RUN pnpm --filter @ai-rag/web-ui build

# 运行阶段：nginx 托管静态文件并反代 /api 到 nest
FROM nginx:1.27-alpine
COPY --from=build /app/apps/web-ui/dist /usr/share/nginx/html
COPY docker/nginx-web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
